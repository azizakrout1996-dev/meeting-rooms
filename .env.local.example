# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: override the door/admin PINs and the cookie-signing secret.
# If you skip these, the app falls back to 2600 / 4444 and a default
# secret -- fine to start with, but you can set your own here any time.
# APP_PIN=2600
# ADMIN_PIN=4444
# SESSION_SECRET=any-random-string
